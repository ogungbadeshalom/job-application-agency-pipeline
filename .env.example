# Copy to .env.local and fill in real values.

# --- Postgres (self-hosted) ---
# Local dev: `docker compose up -d db` then use the URL below.
# VPS: postgres://<user>:<pass>@localhost:5432/<db>
DATABASE_URL=postgres://jobbids:jobbids@localhost:5434/job_bidder

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=replace-with-generated-secret
AUTH_TRUST_HOST=true

# First admin bootstrap (used by `npm run db:seed`):
ADMIN_EMAIL=admin@jobbidder.com
ADMIN_PASSWORD=changeme

# --- Local disk storage ---
# Folder for uploaded resumes + tailored resume PDFs (gitignored).
STORAGE_DIR=./data/uploads

# --- AI ---
# Provider/model/key are configured in-app at Admin → Settings → AI Configuration
# (encrypted-at-rest in app_config). The env vars below are an OPTIONAL
# fallback when no row exists in app_config (e.g. first boot).
#
# AI_STUB=true (default) = deterministic demo output without a key.
# AI_STUB=false + a real key = real model calls.
#
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5
#
# OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# AI_PROVIDER=openrouter
# AI_MODEL=anthropic/claude-3-5-sonnet
#
# Custom OpenAI-compatible endpoint (Ollama / LM Studio / OpenCode / freeinference.org)
# AI_PROVIDER=custom
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3
# AI_API_KEY=ollama
AI_STUB=true